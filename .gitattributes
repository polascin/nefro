# Shell skripty a git hooky musia mať LF konce riadkov,
# inak na Windows checkoute zlyhajú s „/bin/sh^M: bad interpreter".
hooks/* text eol=lf
*.sh    text eol=lf

# Trunk/Prettier must see the same line endings on Windows, WSL and CI.
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.py    text eol=lf

# Dodané knižnice (katex a podobné) sa overujú registrom závislostí podľa
# SHA-256. Register bol vypočítaný v tvare s koncom riadku LF; bez tohto
# pravidla by `core.autocrlf=true` na Windows konvertoval súbory na CRLF
# a kontrola by hlásila nesúlad, hoci by sa obsah nezmenil.
assets/katex/** text eol=lf

# Binárne súbory — git ich nesmie normalizovať / meniť konce riadkov
*.png   binary
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
