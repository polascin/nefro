#!/usr/bin/env bash
# Pre-commit kontroly:
#   1) php -l syntax check staged PHP súborov (rýchle, bez falošných nálezov)
#   2) automatická konverzia PNG → WebP

# --- 1) PHP syntax check staged súborov ---
if ! git diff --cached --check; then
	echo "pre-commit: commit zastavený kvôli whitespace chybe." >&2
	exit 1
fi

if command -v php >/dev/null 2>&1; then
	php_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.php')
	if [ -n "$php_files" ]; then
		syntax_ok=1
		echo "$php_files" | while IFS= read -r f; do
			[ -f "$f" ] || continue
			if ! php -l "$f" >/dev/null 2>&1; then
				echo "pre-commit: SYNTAX CHYBA v $f" >&2
				php -l "$f" >&2
				exit 1
			fi
		done || syntax_ok=0
		[ "$syntax_ok" -eq 0 ] && {
			echo "pre-commit: commit zastavený kvôli PHP syntax chybe." >&2
			exit 1
		}
	fi
fi
# Pozn.: hlbšiu statickú analýzu (PHPStan + PHP-CS-Fixer) spúšťaj ručne:
#   pwsh tools/quality.ps1   (-Fix na aplikovanie formátovania)

# --- 2) Auto-vodoznak + konverzia PNG → WebP pred commitom ---
# Pre staged obsahové obrázky v img/ sa najprv zapečie značkový vodoznak
# (tools/watermark_images.php — idempotentné cez manifest; logá/avatary/OG sú
# vylúčené v DENY_PATTERNS), potom sa pre PNG vytvorí WebP súrodenec. PNG
# zostáva ako fallback (content negotiation v .htaccess).

# Existujú staged obsahové obrázky v img/?
staged_count=$(git diff --cached --name-only --diff-filter=ACM -- 'img/*.png' 'img/*.jpg' 'img/*.jpeg' | wc -l)
[ "$staged_count" -eq 0 ] && exit 0

# Bez PHP vodoznak aj konverziu preskočíme (commit nezablokujeme).
if ! command -v php >/dev/null 2>&1; then
	echo "pre-commit: php nenájdený — preskakujem vodoznak a PNG→WebP." >&2
	exit 0
fi

# 2a) Zapeč vodoznak do staged obrázkov (in-place, idempotentné cez manifest).
git diff --cached --name-only --diff-filter=ACM -z -- 'img/*.png' 'img/*.jpg' 'img/*.jpeg' \
	| xargs -0 -r php tools/watermark_images.php --stage || {
	echo "pre-commit: vodoznak zlyhal — commit zastavený." >&2
	exit 1
}

# Re-add ovodoznakované obrázky + manifest (working-tree verzia ≠ index).
git diff --cached --name-only --diff-filter=ACM -z -- 'img/*.png' 'img/*.jpg' 'img/*.jpeg' \
	| while IFS= read -r -d '' f; do
	[ -f "$f" ] && git add "$f"
done
[ -f tools/.watermark-manifest.json ] && git add tools/.watermark-manifest.json

# 2b) Skonvertuj neaktuálne PNG v img/ na WebP (z už ovodoznakovaného PNG).
php tools/convert_images_webp.php || {
	echo "pre-commit: konverzia PNG→WebP zlyhala — commit zastavený." >&2
	exit 1
}

# Pridaj vygenerované .webp súrodence k staged PNG (robustné voči medzerám v názve).
git diff --cached --name-only --diff-filter=ACM -z -- 'img/*.png' | while IFS= read -r -d '' f; do
	webp="${f%.png}.webp"
	[ -f "$webp" ] && git add "$webp"
done

exit 0
