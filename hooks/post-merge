#!/usr/bin/env bash
#
# post-merge: nasadí zmeny, ktoré prišli zlúčením vetvy (git merge / git pull).
#
# `post-commit` sa viaže výlučne na lokálny `git commit`, merge bez vlastného
# commitu (fast-forward) by inak deploy nespustil a produkcia by driftovala.
# Bázu deployu berieme prednostne z produkčného `deploy_info.php`, takže sa
# dobehne aj drift nazbieraný skôr. Push do záloh až po nasadení, ako v post-commit.

set -uo pipefail

# Squash merge ($1 == 1) nechá zmeny len v indexe, HEAD ich ešte neobsahuje.
if [[ ${1:-0} == 1 ]]; then
	echo "[post-merge] Squash merge: deploy až po commite."
	exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO_ROOT" || exit 1

BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || {
	echo "[post-merge] Detached HEAD; deploy preskakujem." >&2
	exit 0
}

if [[ $BRANCH != main ]]; then
	echo "[post-merge] Vetva $BRANCH: produkcia sa nasadzuje iba z main."
	exit 0
fi

DEPLOY_SCRIPT="$REPO_ROOT/hooks/deploy.sh"
if [[ ! -f $DEPLOY_SCRIPT ]]; then
	echo "[post-merge] Chýba deploy skript: $DEPLOY_SCRIPT" >&2
	exit 1
fi

HEAD_SHA=$(git rev-parse HEAD)

# 1) Báza = commit, na ktorom reálne stojí produkcia (self-healing).
BASE_REF=""
REMOTE_COMMIT=$("$DEPLOY_SCRIPT" --remote-commit 2>/dev/null) || REMOTE_COMMIT=""
# Prijmi len čistý hex SHA, nech sa prípadná hláška nikdy nevydáva za commit.
if [[ $REMOTE_COMMIT =~ ^[0-9a-fA-F]{4,40}$ ]] && git rev-parse --verify "${REMOTE_COMMIT}^{commit}" >/dev/null 2>&1; then
	if [[ $(git rev-parse "$REMOTE_COMMIT") == "$HEAD_SHA" ]]; then
		echo "[post-merge] Produkcia je v súlade s HEAD ($REMOTE_COMMIT); niet čo nasadiť."
		exit 0
	fi
	BASE_REF=$REMOTE_COMMIT
	BEHIND=$(git rev-list --count "$REMOTE_COMMIT..HEAD" 2>/dev/null || echo "?")
	echo "[post-merge] Server je na $REMOTE_COMMIT, HEAD $(git rev-parse --short HEAD) (+$BEHIND commitov); dobieham rozdiel."
else
	echo "[post-merge] Stav servera sa nepodarilo zistiť; použijem ORIG_HEAD." >&2
fi

# 2) Fallback = stav pred mergom.
if [[ -z $BASE_REF ]] && git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
	BASE_REF=$(git rev-parse ORIG_HEAD)
	if [[ $BASE_REF == "$HEAD_SHA" ]]; then
		echo "[post-merge] Merge nezmenil HEAD; niet čo nasadiť."
		exit 0
	fi
fi

if [[ -n $BASE_REF ]]; then
	"$DEPLOY_SCRIPT" "$BASE_REF"
else
	"$DEPLOY_SCRIPT"
fi
DEPLOY_RC=$?

MIRRORS=$(git config --get nefro.mirrors || echo "server origin")
for remote in $MIRRORS; do
	git remote get-url "$remote" >/dev/null 2>&1 || continue
	if git push --quiet "$remote" "HEAD:refs/heads/$BRANCH" 2>/dev/null; then
		echo "[post-merge] Záloha: $BRANCH -> $remote"
	else
		echo "[post-merge] Záloha do $remote zlyhala (produkcie sa to netýka)." >&2
	fi
done

exit "$DEPLOY_RC"
