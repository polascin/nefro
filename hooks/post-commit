#!/usr/bin/env bash
#
# post-commit: z vetvy main nasadí na produkciu, potom pushne do záloh.
#
# Vývoj nezávisí od GitHubu: overenie robí lokálna brána (hooks/local_gate.sh,
# volá ju deploy.sh) a nasadenie ide priamo cez SFTP. Push do vzdialených
# repozitárov je až potom a len ako záloha; jeho zlyhanie (výpadok siete,
# ochrana vetvy na GitHube) produkciu neblokuje ani nevracia.
#
# Zálohy: medzerou oddelený zoznam v `git config nefro.mirrors`
# (predvolene "server origin"; nastavené, ale neexistujúce remoty sa preskočia).

set -uo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO_ROOT" || exit 1

BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || {
	echo "[post-commit] Detached HEAD; deploy a zálohu preskakujem." >&2
	exit 0
}

push_mirrors() {
	local mirrors remote any=0
	mirrors=$(git config --get nefro.mirrors || echo "server origin")
	for remote in $mirrors; do
		git remote get-url "$remote" >/dev/null 2>&1 || continue
		any=1
		if git push --quiet "$remote" "HEAD:refs/heads/$BRANCH" 2>/dev/null; then
			echo "[post-commit] Záloha: $BRANCH -> $remote"
		else
			echo "[post-commit] Záloha do $remote zlyhala (produkcie sa to netýka)." >&2
		fi
	done
	((any)) || echo "[post-commit] Žiadny záložný remote nie je nastavený (git config nefro.mirrors)." >&2
}

DEPLOY_RC=0
if [[ $BRANCH == main ]]; then
	DEPLOY_SCRIPT="$REPO_ROOT/hooks/deploy.sh"
	if [[ ! -f $DEPLOY_SCRIPT ]]; then
		echo "[post-commit] Chýba deploy skript: $DEPLOY_SCRIPT" >&2
		DEPLOY_RC=1
	else
		# Báza = commit, na ktorom reálne stojí produkcia, takže sa dobehne aj
		# skorší nenasadený rozdiel. Bez nej sa nasadí len posledný commit.
		BASE_REF=$("$DEPLOY_SCRIPT" --remote-commit 2>/dev/null) || BASE_REF=""
		if [[ $BASE_REF =~ ^[0-9a-fA-F]{4,40}$ ]] && git rev-parse --verify "${BASE_REF}^{commit}" >/dev/null 2>&1; then
			"$DEPLOY_SCRIPT" "$BASE_REF"
		else
			"$DEPLOY_SCRIPT"
		fi
		DEPLOY_RC=$?
	fi
else
	echo "[post-commit] Vetva $BRANCH: produkcia sa nasadzuje iba z main."
fi

push_mirrors

if ((DEPLOY_RC != 0)); then
	echo "[post-commit] Nasadenie skončilo kódom $DEPLOY_RC; commit je lokálne a v zálohách." >&2
fi
exit "$DEPLOY_RC"
