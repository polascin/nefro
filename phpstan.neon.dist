parameters:
    # Začni nízko (0–4). Po vyčistení nálezov môžeš úroveň postupne zvyšovať až po 9.
    level: 4

    # Analyzuj ako PHP 8.5 (produkcia 8.5.x) bez ohľadu na interpreter, ktorý
    # PHPStan spúšťa. Triedy Pdo\Mysql a Pdo\Sqlite existujú od PHP 8.4; pod
    # PHP 8.3 (cloudový audit) ich inak PHPStan hlási ako neznáme (Behy 131, 133).
    phpVersion: 80500

    paths:
        - .

    # Plochý projekt s množstvom jednorazových skriptov — vylúč generované/cudzie veci.
    excludePaths:
        # Úvodný wildcard udrží vylúčenia funkčné aj v cestách, ktoré
        # macOS/OneDrive reprezentuje inou Unicode normalizáciou.
        - */.trunk/*
        - */.kilo/*
        - */tools/*.phar
        - phar://*/tools/phpstan.phar/*
        - */scratch/*
        - */private/*
        - */pdf/*
        - */uploads/*
        - */img/*
        - */assets/*
        - */vendor/*
        - */node_modules/*

    # Existujúce nálezy sú v baseline — blokujú len NOVÉ chyby.
    # (Súbor vytvorí install-dev-tools.ps1; placeholder je v repe, aby include nezlyhal.)

includes:
    - phpstan-baseline.neon
