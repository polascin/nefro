# ── Bezpečnostné blokovanie citlivých súborov ──────────────────────────────

# Databázový setup skript — prístupný iba cez CLI, nie cez web
<Files "setup_db.php">
    Require all denied
</Files>
<Files "seed_municipalities_sk.php">
    Require all denied
</Files>

# Vývojové diagnostické skripty — nie sú určené pre produkčný prístup
<Files "query_article.php">
    Require all denied
</Files>

# Konfiguračné súbory — nikdy nesmú byť stiahnuteľné
<Files "*.ini">
    Require all denied
</Files>
<Files "*.env">
    Require all denied
</Files>

# Rewrite sitemap.xml na sitemap.php
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Vývojové Python skripty — nie sú určené pre web prístup
<FilesMatch "\.py$">
    Require all denied
</FilesMatch>

# Extrahované a pomocné textové súbory — nie sú určené pre web prístup
<FilesMatch "^(extracted_utf8|pages_70s|pages_detailed|pages_text|extracted_info)\.txt$">
    Require all denied
</FilesMatch>
