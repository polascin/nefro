# ── Základné bezpečnostné nastavenia ────────────────────────────────────────
# DÔLEŽITÉ: -FollowSymLinks sa NESMIE používať v .htaccess pokiaľ mod_rewrite
# beží v rovnakom adresári. mod_rewrite vyžaduje FollowSymLinks alebo
# SymLinksIfOwnerMatch — bez toho vráti Apache 403 pre každú požiadavku.
# ServerSignature vyžaduje AllowOverride All — ak server vracia 500, zakomentuj.
Options -Indexes
ServerSignature Off

# ── Globálne bezpečnostné HTTP hlavičky ─────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ── Blokovanie .git adresára a citlivých súborov ─────────────────────────────
# DÔLEŽITÉ: <DirectoryMatch> NIE JE povolená v .htaccess (len v httpd.conf).
# Adresáre blokujeme cez RewriteRule a RedirectMatch (povolené v .htaccess).

# Blokuj súbory začínajúce na .git (napr. .gitignore)
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

# Lokálne dev konfigy (PHPStan, PHP-CS-Fixer, Trunk) — len lokálny vývoj, nie cez web
<FilesMatch "^(phpstan.*|\.php-cs-fixer.*|trunk\.ya?ml)$">
    Require all denied
</FilesMatch>

# Interné Markdown dokumenty (.agent.md, AGENTS.md, README, PUBLIKOVANIE_*) —
# obsahujú vývojársku/bezpečnostnú dokumentáciu, nikdy cez web
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# ── Blokovanie vývojových adresárov cez RewriteRule ─────────────────────────
# (RedirectMatch/RewriteRule sú v .htaccess povolené)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokovanie .git, scratch, hooks, tools, .vscode, .kilo, .trunk adresárov
    RewriteRule ^(\.git|scratch|hooks|tools|\.vscode|\.kilo|\.trunk)(/.*)?$ - [F,L]

    # Rewrite sitemap.xml → sitemap.php
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # ── Hotlink protection (ochrana proti vkladaniu obrázkov cudzími webmi) ──
    # Cieľ NIE JE zabrániť stiahnutiu (to sa nedá) — bráni cudzím stránkam
    # priamo vkladať naše obrázky a míňať nám prenos. Stiahnutý súbor aj tak
    # nesie zapečený vodoznak (pozri tools/watermark_images.php).
    #
    # Povolené (request prejde):
    #   • prázdny Referer — priame otvorenie, OG/sociálne crawlery, súkromné prehliadače
    #   • vlastné domény (nefro.polascin.net + subdomény, lokálny vývoj)
    #   • veľké vyhľadávače — aby obrázky ostali viditeľné v Google/Bing Images (dosah)
    # Všetko ostatné s cudzím Refererom dostane 403 pre obrázkové prípony.
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?nefro\.polascin\.net(:[0-9]+)?(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?(/|$) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?(google|bing|duckduckgo|yahoo|yandex|ecosia)\. [NC]
    RewriteRule \.(png|webp|jpe?g|gif|svg)$ - [F,NC,L]

    # Transparentné servírovanie WebP namiesto PNG (content negotiation).
    # Ak prehliadač akceptuje image/webp a vedľa PNG existuje .webp súrodenec,
    # pošle sa WebP. HTML naďalej odkazuje na .png; PNG ostáva ako fallback.
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule ^(img/.+)\.png$ $1.webp [T=image/webp,E=WEBP_SERVED:1,L]

    # To isté pre JPEG (foo.jpg/foo.jpeg → foo.webp, ak WebP súrodenec existuje).
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule ^(img/.+)\.jpe?g$ $1.webp [T=image/webp,E=WEBP_SERVED:1,L]
</IfModule>

# ── WebP: MIME typ a korektné cachovanie ────────────────────────────────────
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>
<IfModule mod_headers.c>
    # Proxy/CDN musia cachovať pôvodný (PNG/JPEG) aj WebP variant podľa Accept
    <FilesMatch "\.(png|jpe?g|webp)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# ── Bezpečnostné blokovanie citlivých súborov ──────────────────────────────

# Databázový setup — prístupný iba cez CLI, nie cez web
<Files "setup_db.php">
    Require all denied
</Files>
<Files "seed_municipalities_sk.php">
    Require all denied
</Files>
<Files "import_municipalities_from_csv.php">
    Require all denied
</Files>

# Vývojové a diagnostické skripty
<Files "query_article.php">
    Require all denied
</Files>
<Files "generate_og_image.php">
    Require all denied
</Files>
<Files "add_search_ft_index.php">
    Require all denied
</Files>
<Files "refresh_article.php">
    Require all denied
</Files>

# Testovací pomocník (seed pre smoke-test) — len CLI/lokálne, nikdy cez web
<Files "smoke_seed_pdf.php">
    Require all denied
</Files>

# Hromadná (re)generácia PDF — len CLI/SSH (sync_article_pdfs.sh); bez browser UI,
# admin cesta beží cez POST+CSRF v admin_articles.php (nie cez tento skript)
<Files "generate_all_article_pdfs.php">
    Require all denied
</Files>

# Newsletter a údržbové CLI skripty — spúšťané len cez SSH/cron (php_sapi_name
# guard v kóde + defense-in-depth deny tu). Bez browser UI.
<Files "newsletter_worker.php">
    Require all denied
</Files>
<Files "newsletter_weekly_digest.php">
    Require all denied
</Files>
<Files "newsletter_apology_broken_links.php">
    Require all denied
</Files>
<Files "archive_cleanup.php">
    Require all denied
</Files>
<Files "update_sitemap.php">
    Require all denied
</Files>
<Files "sync_clinical_trials.php">
    Require all denied
</Files>

# Knižničné PHP súbory — prístupné len ako include, nie priamo cez web
<FilesMatch "^(db_config|config_loader|auth|phone_utils|calculators_common|header|header_profile|footer|head_meta|calculator_disclaimer|email_verification|mobile_verification|pdf_generator|source_authors)\.php$">
    Require all denied
</FilesMatch>

# Konfiguračné súbory
<Files "*.ini">
    Require all denied
</Files>
<Files "*.env">
    Require all denied
</Files>

# Dočasné vývojové JS súbory
<FilesMatch "^tmp_.*\.js$">
    Require all denied
</FilesMatch>

# Archívy a komprimované balíčky
<FilesMatch "\.(tgz|tar\.gz|bz2|7z)$">
    Require all denied
</FilesMatch>

# Vývojové Python a shell skripty
<FilesMatch "\.(py|sh)$">
    Require all denied
</FilesMatch>

# Extrahované pomocné textové súbory
<FilesMatch "^(extracted_utf8|pages_70s|pages_detailed|pages_text|extracted_info)\.txt$">
    Require all denied
</FilesMatch>
